# Datasets (downloaded and tokenized; rebuild with `python -m src.data`)
data/raw/
data/processed/

# Training checkpoints (several GB each)
checkpoints/

# Saved models: NLLB models (~1.2 GB each) are hosted externally (see README).
# The scratch model (~46 MB) is small enough to commit.
models/*
!models/scratch/
models/scratch/spm.vocab
# Experiment 2: keep only the small scratch model.
!models/augmented/
models/augmented/*
!models/augmented/scratch/
models/augmented/scratch/spm.vocab

# Zip bundle for uploading to Google Drive
dist/

# Python caches
__pycache__/
*.py[cod]

# Editor settings (contain paths specific to this PC)
.vscode/

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Environment variables / secrets
.env
